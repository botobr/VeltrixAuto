# Másold .env néven, és töltsd ki.

PORT=3600
MONGO_DB=mongodb+srv://felhasznalo:jelszo@cluster.example.mongodb.net/veltrix
SESSION_SECRET=hosszu-veletlen-titok
# A frontend nyilvános címe: CORS, e-mailekben lévő linkek, sitemap.xml, robots.txt, megosztó oldalak.
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Reverse proxy (pl. nginx) mögött: 1 – különben a kéréskorlátozó mindenkit egy IP-nek lát.
TRUST_PROXY=

CLOUDINARY_API_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail értesítések (érdeklődés, mentett keresés). Ha SMTP_HOST üres, a levelek csak a konzolra kerülnek.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Veltrix Autók <no-reply@veltrix.hu>
# Ha a telephelynek nincs e-mail-címe, ide mennek az érdeklődések (vesszővel több cím). Üresen: minden admin.
ERTESITESI_EMAIL=

# Webshop – online kártyás fizetés (Stripe Checkout). Mindkettő kell; ha üres, a kártyás fizetés nem választható.
# Teszteléshez: https://dashboard.stripe.com/test/apikeys és a webhook végpont: <API_URL>/api/fizetes/webhook
# (események: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Előre utalásos fizetéshez a visszaigazolásban és az e-mailben megjelenő adatok.
BANKSZAMLASZAM=
BANKSZAMLA_KEDVEZMENYEZETT=
